{
  "$description": "Component tokens of the shared runtime: backgrounds, chapter label, presenter frame, captions, card text, icon tiles, window chrome and the final fade.",
  "glow": {
    "accent": { "$value": "{color.accent}", "$type": "color", "$extensions": { "avatars": { "alpha": 0.28 } } },
    "info": { "$value": "{color.info}", "$type": "color", "$extensions": { "avatars": { "alpha": 0.18 } } },
    "fade": { "$value": "{color.bg}", "$type": "color", "$extensions": { "avatars": { "alpha": 0 } } }
  },
  "grid": {
    "line": { "$value": "{color.text-muted}", "$type": "color", "$extensions": { "avatars": { "alpha": 0.08 } } },
    "fade": { "$value": "{color.black}", "$type": "color", "$extensions": { "avatars": { "alpha": 0 } } },
    "opacity": { "$value": 0.35, "$type": "number" },
    "size": { "$value": "64px", "$type": "dimension" },
    "drift-x": { "$value": 6, "$type": "number", "$description": "px per second the grid drifts right" },
    "drift-y": { "$value": 10, "$type": "number", "$description": "px per second the grid drifts down" }
  },
  "chapter": {
    "color": { "$value": "{color.text-muted}", "$type": "color" },
    "accent": { "$value": "{color.accent-soft}", "$type": "color" },
    "dot": { "$value": "{color.accent}", "$type": "color" },
    "dot-radius": { "$value": "{radius.2xs}", "$type": "dimension" },
    "size": { "$value": "{font.size.sm}", "$type": "dimension" },
    "weight": { "$value": "{font.weight.semibold}", "$type": "fontWeight" }
  },
  "presenter": {
    "backdrop-inner": { "$value": "{color.accent-strong}", "$type": "color" },
    "backdrop-outer": { "$value": "{color.bg-alt}", "$type": "color" },
    "ring": { "$value": "{color.accent}", "$type": "color" },
    "ring-inset": { "$value": "{color.bg}", "$type": "color", "$extensions": { "avatars": { "alpha": 0.6 } } }
  },
  "caption": {
    "bg": { "$value": "{color.bg}", "$type": "color", "$extensions": { "avatars": { "alpha": 0.78 } } },
    "border": { "$value": "{color.accent-soft}", "$type": "color", "$extensions": { "avatars": { "alpha": 0.18 } } },
    "text": { "$value": "{color.text}", "$type": "color", "$extensions": { "avatars": { "alpha": 0.55 } }, "$description": "words not yet spoken" },
    "text-on": { "$value": "{color.text-strong}", "$type": "color", "$description": "spoken words" },
    "radius": { "$value": "{radius.2xl}", "$type": "dimension" },
    "size": { "$value": "{font.size.3xl}", "$type": "dimension" },
    "weight": { "$value": "{font.weight.semibold}", "$type": "fontWeight" }
  },
  "kicker": {
    "color": { "$value": "{color.accent-soft}", "$type": "color" },
    "size": { "$value": "{font.size.md}", "$type": "dimension" },
    "weight": { "$value": "{font.weight.bold}", "$type": "fontWeight" }
  },
  "headline": {
    "color": { "$value": "{color.text-strong}", "$type": "color" },
    "size": { "$value": "{font.size.7xl}", "$type": "dimension" },
    "weight": { "$value": "{font.weight.extrabold}", "$type": "fontWeight" }
  },
  "slide-title": {
    "color": { "$value": "{color.text-strong}", "$type": "color" },
    "size": { "$value": "{font.size.5xl}", "$type": "dimension" },
    "weight": { "$value": "{font.weight.extrabold}", "$type": "fontWeight" }
  },
  "icon": {
    "stroke": { "$value": "{color.accent-soft}", "$type": "color" },
    "bg": { "$value": "{color.accent}", "$type": "color", "$extensions": { "avatars": { "alpha": 0.16 } } }
  },
  "window": {
    "bg": { "$value": "{color.surface-sunken}", "$type": "color" },
    "border": { "$value": "{color.border}", "$type": "color" },
    "radius": { "$value": "{radius.4xl}", "$type": "dimension" },
    "shadow": { "$value": "{shadow.lg}", "$type": "shadow" },
    "bar-height": { "$value": "58px", "$type": "dimension" },
    "bar-bg": { "$value": "{color.surface-bar}", "$type": "color" },
    "bar-border": { "$value": "{color.border-subtle}", "$type": "color" },
    "dot-close": { "$value": "{color.danger}", "$type": "color" },
    "dot-min": { "$value": "{color.warn}", "$type": "color" },
    "dot-max": { "$value": "{color.ok}", "$type": "color" },
    "title-color": { "$value": "{color.text-muted}", "$type": "color" },
    "title-size": { "$value": "{font.size.2xs}", "$type": "dimension" }
  },
  "blackout": {
    "bg": { "$value": "{color.black}", "$type": "color" }
  }
}
