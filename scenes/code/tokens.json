{
  "$description": "Code scene: file panels (window bar, coloured lines, highlights) and note chips.",
  "code": {
    "pad-x": { "$value": "36px", "$type": "dimension", "$description": "horizontal padding of a line; the font fit uses it" },
    "pad-y": { "$value": "20px", "$type": "dimension", "$description": "vertical padding of the panel body; the font fit uses it" },
    "note-height": { "$value": "62px", "$type": "dimension", "$description": "height of a note chip; notes are stacked by it" },
    "text": { "$value": "{color.text}", "$type": "color" },
    "hl-bg": { "$value": "{color.accent-soft}", "$type": "color", "$extensions": { "avatars": { "alpha": 0.16 } } },
    "hl-bar": { "$value": "{color.accent-soft}", "$type": "color" },
    "hl-radius": { "$value": "{radius.sm}", "$type": "dimension" },
    "key": { "$value": "{color.accent-soft}", "$type": "color" },
    "string": { "$value": "{color.info-soft}", "$type": "color" },
    "comment": { "$value": "{color.code-comment}", "$type": "color" },
    "keyword": { "$value": "{color.code-keyword}", "$type": "color" },
    "punct": { "$value": "{color.text-muted}", "$type": "color" },
    "note-bg": { "$value": "{color.surface}", "$type": "color", "$extensions": { "avatars": { "alpha": 0.85 } } },
    "note-border": { "$value": "{color.border}", "$type": "color" },
    "note-color": { "$value": "{color.text-strong}", "$type": "color" },
    "note-radius": { "$value": "{radius.xl}", "$type": "dimension" },
    "note-size": { "$value": "{font.size.sm}", "$type": "dimension" },
    "note-weight": { "$value": "{font.weight.semibold}", "$type": "fontWeight" },
    "note-icon-radius": { "$value": "{radius.md}", "$type": "dimension" },
    "note-warn": { "$value": "{color.warn}", "$type": "color" },
    "note-warn-bg": { "$value": "{color.warn}", "$type": "color", "$extensions": { "avatars": { "alpha": 0.16 } } }
  }
}
