{
  "$description": "Diagram scene: nodes, groups, edges and their labels.",
  "diagram": {
    "node-bg": { "$value": "{color.surface-raised}", "$type": "color" },
    "node-border": { "$value": "{color.border}", "$type": "color" },
    "node-radius": { "$value": "{radius.3xl}", "$type": "dimension" },
    "node-shadow": { "$value": "{shadow.md}", "$type": "shadow" },
    "node-accent-bg": { "$value": "{color.surface-raised}", "$type": "color" },
    "node-accent-border": { "$value": "{color.accent}", "$type": "color" },
    "ghost-bg": { "$value": "{color.surface}", "$type": "color", "$extensions": { "avatars": { "alpha": 0.45 } } },
    "ghost-shadow": { "$value": "{shadow.none}", "$type": "shadow", "$description": "a ghost node's shadow while it pulses" },
    "icon-radius": { "$value": "{radius.lg}", "$type": "dimension" },
    "title-color": { "$value": "{color.text-strong}", "$type": "color" },
    "title-size": { "$value": "{font.size.md}", "$type": "dimension" },
    "title-weight": { "$value": "{font.weight.bold}", "$type": "fontWeight" },
    "text-color": { "$value": "{color.text-muted}", "$type": "color" },
    "text-size": { "$value": "{font.size.2xs}", "$type": "dimension" },
    "code-size": { "$value": "{font.size.3xs}", "$type": "dimension" },
    "group-fill": { "$value": "{color.accent}", "$type": "color", "$extensions": { "avatars": { "alpha": 0.05 } } },
    "group-stroke": { "$value": "{color.accent-soft}", "$type": "color", "$extensions": { "avatars": { "alpha": 0.45 } } },
    "group-accent": { "$value": "{color.accent}", "$type": "color" },
    "group-radius": { "$value": "{radius.5xl}", "$type": "dimension" },
    "group-label-color": { "$value": "{color.accent-soft}", "$type": "color" },
    "group-label-size": { "$value": "{font.size.2xs}", "$type": "dimension" },
    "group-label-weight": { "$value": "{font.weight.bold}", "$type": "fontWeight" },
    "edge": { "$value": "{color.text-muted}", "$type": "color" },
    "edge-accent": { "$value": "{color.accent-soft}", "$type": "color" },
    "label-bg": { "$value": "{color.bg}", "$type": "color" },
    "label-border": { "$value": "{color.border}", "$type": "color" },
    "label-color": { "$value": "{color.text}", "$type": "color" },
    "label-radius": { "$value": "{radius.pill}", "$type": "dimension" },
    "label-size": { "$value": "{font.size.2xs}", "$type": "dimension" },
    "label-weight": { "$value": "{font.weight.semibold}", "$type": "fontWeight" },
    "pulse": { "$value": "{color.accent-soft}", "$type": "color", "$description": "the ring a pulsing node sends out" },
    "reveal-mask": { "$value": "{color.white}", "$type": "color", "$description": "mask stroke that draws edges; white shows them fully" }
  }
}
