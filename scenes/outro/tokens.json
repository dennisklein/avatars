{
  "$description": "Outro scene: thanks, the brand's links and the next episode.",
  "outro": {
    "link-color": { "$value": "{color.text-strong}", "$type": "color" },
    "link-size": { "$value": "{font.size.xl}", "$type": "dimension" },
    "link-weight": { "$value": "{font.weight.semibold}", "$type": "fontWeight" },
    "label-color": { "$value": "{color.accent-soft}", "$type": "color" },
    "label-size": { "$value": "{font.size.sm}", "$type": "dimension" },
    "next-bg": { "$value": "{color.accent}", "$type": "color", "$extensions": { "avatars": { "alpha": 0.1 } } },
    "next-border": { "$value": "{color.accent}", "$type": "color" },
    "next-radius": { "$value": "{radius.4xl}", "$type": "dimension" },
    "next-kicker-size": { "$value": "{font.size.xs}", "$type": "dimension" },
    "next-color": { "$value": "{color.text-strong}", "$type": "color" },
    "next-size": { "$value": "{font.size.4xl}", "$type": "dimension" },
    "next-weight": { "$value": "{font.weight.extrabold}", "$type": "fontWeight" }
  }
}
