{
  "$description": "Terminal scene: a seekable terminal window with typed commands, output, highlights and a fast-forward badge.",
  "terminal": {
    "pad-x": { "$value": "34px", "$type": "dimension", "$description": "horizontal padding of the body; the font fit uses it" },
    "pad-y": { "$value": "26px", "$type": "dimension", "$description": "vertical padding of the body; the row count uses it" },
    "line-height": { "$value": 1.55, "$type": "number" },
    "text": { "$value": "{color.text}", "$type": "color" },
    "prompt": { "$value": "{color.accent}", "$type": "color" },
    "prompt-weight": { "$value": "{font.weight.bold}", "$type": "fontWeight" },
    "out": { "$value": "{color.text-dim}", "$type": "color" },
    "cursor": { "$value": "{color.accent-soft}", "$type": "color" },
    "mark-bg": { "$value": "{color.accent-soft}", "$type": "color" },
    "mark-color": { "$value": "{color.on-accent}", "$type": "color" },
    "mark-radius": { "$value": "{radius.xs}", "$type": "dimension" },
    "ff-bg": { "$value": "{color.info}", "$type": "color", "$extensions": { "avatars": { "alpha": 0.18 } } },
    "ff-border": { "$value": "{color.info}", "$type": "color" },
    "ff-color": { "$value": "{color.info-soft}", "$type": "color" },
    "ff-radius": { "$value": "{radius.pill}", "$type": "dimension" },
    "ff-size": { "$value": "{font.size.xs}", "$type": "dimension" },
    "ff-weight": { "$value": "{font.weight.bold}", "$type": "fontWeight" },
    "cps": { "$value": 32, "$type": "number", "$description": "typing speed, characters per second" },
    "blink": { "$value": 1.8, "$type": "number", "$description": "cursor phase changes per second while idle" },
    "ff-hold": { "$value": 1.6, "$type": "duration", "$description": "how long a fast-forward badge shows" }
  }
}
