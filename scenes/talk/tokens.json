{
  "$description": "Talk scene: the title card beside the full-size presenter, its topic chips and the name tag.",
  "talk": {
    "sub-color": { "$value": "{color.text-muted}", "$type": "color" },
    "sub-size": { "$value": "{font.size.2xl}", "$type": "dimension" },
    "sub-weight": { "$value": "{font.weight.regular}", "$type": "fontWeight" },
    "chip-color": { "$value": "{color.text}", "$type": "color" },
    "chip-bg": { "$value": "{color.surface}", "$type": "color", "$extensions": { "avatars": { "alpha": 0.8 } } },
    "chip-border": { "$value": "{color.border}", "$type": "color" },
    "chip-accent": { "$value": "{color.accent}", "$type": "color", "$description": "border of the first chip" },
    "chip-accent-color": { "$value": "{color.accent-soft}", "$type": "color", "$description": "text of the first chip" },
    "chip-radius": { "$value": "{radius.pill}", "$type": "dimension" },
    "chip-size": { "$value": "{font.size.md}", "$type": "dimension" },
    "chip-weight": { "$value": "{font.weight.semibold}", "$type": "fontWeight" },
    "tag-bg": { "$value": "{color.bg}", "$type": "color", "$extensions": { "avatars": { "alpha": 0.85 } } },
    "tag-accent": { "$value": "{color.accent}", "$type": "color" },
    "tag-radius": { "$value": "{radius.xl}", "$type": "dimension" },
    "name-color": { "$value": "{color.text-strong}", "$type": "color" },
    "name-size": { "$value": "{font.size.4xl}", "$type": "dimension" },
    "name-weight": { "$value": "{font.weight.extrabold}", "$type": "fontWeight" },
    "role-color": { "$value": "{color.accent-soft}", "$type": "color" },
    "role-size": { "$value": "{font.size.sm}", "$type": "dimension" },
    "role-weight": { "$value": "{font.weight.semibold}", "$type": "fontWeight" },
    "tag-offset": { "$value": 60, "$type": "number", "$description": "how far the name tag slides in from the left (px)" },
    "tag-hold": { "$value": 5.2, "$type": "duration", "$description": "seconds from the scene start until the name tag leaves" }
  }
}
