{
  "$description": "Slide scene: a title and up to four bullets with icon tiles.",
  "slide": {
    "bullet-bg": { "$value": "{color.surface}", "$type": "color", "$extensions": { "avatars": { "alpha": 0.75 } } },
    "bullet-border": { "$value": "{color.border}", "$type": "color" },
    "bullet-radius": { "$value": "{radius.4xl}", "$type": "dimension" },
    "icon-radius": { "$value": "{radius.2xl}", "$type": "dimension" },
    "bullet-title-color": { "$value": "{color.text-strong}", "$type": "color" },
    "bullet-title-size": { "$value": "{font.size.3xl}", "$type": "dimension" },
    "bullet-title-weight": { "$value": "{font.weight.bold}", "$type": "fontWeight" },
    "bullet-text-color": { "$value": "{color.text-muted}", "$type": "color" },
    "bullet-text-size": { "$value": "{font.size.md}", "$type": "dimension" },
    "enter-offset": { "$value": 50, "$type": "number", "$description": "how far a bullet slides in from the left (px)" },
    "enter-duration": { "$value": 0.45, "$type": "duration" }
  }
}
