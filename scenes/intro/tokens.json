{
  "$description": "Intro scene: the brand lockup, the episode title and the presenter's disclosure.",
  "intro": {
    "wordmark-color": { "$value": "{color.text-strong}", "$type": "color" },
    "wordmark-size": { "$value": "{font.size.8xl}", "$type": "dimension" },
    "wordmark-weight": { "$value": "{font.weight.semibold}", "$type": "fontWeight" },
    "wordmark-gap": { "$value": "0.125em", "$type": "dimension", "$description": "space under the wordmark's line box, so descenders (g, j, p, q, y) clear the tagline; 0 sets the tagline right under the line box" },
    "tagline-color": { "$value": "{color.text-muted}", "$type": "color" },
    "tagline-size": { "$value": "{font.size.2xs}", "$type": "dimension" },
    "tagline-weight": { "$value": "{font.weight.semibold}", "$type": "fontWeight" },
    "kicker-size": { "$value": "{font.size.lg}", "$type": "dimension" },
    "headline-size": { "$value": "{font.size.6xl}", "$type": "dimension" },
    "disclosure-color": { "$value": "{color.text-muted}", "$type": "color", "$extensions": { "avatars": { "alpha": 0.75 } } },
    "disclosure-size": { "$value": "{font.size.3xs}", "$type": "dimension" },
    "wordmark-offset": { "$value": 40, "$type": "number", "$description": "how far the wordmark rises in (px)" },
    "tagline-offset": { "$value": 16, "$type": "number", "$description": "how far the tagline rises in (px)" }
  }
}
