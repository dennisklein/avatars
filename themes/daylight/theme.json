    ["window.title-color", "window.bar-bg", 4.5],
    ["terminal.text", "window.bg", 4.5],
    ["terminal.out", "window.bg", 4.5],
    ["terminal.prompt", "window.bg", 4.5],
    ["terminal.ff-color", "window.bg", 4.5],
    ["terminal.mark-color", "terminal.mark-bg", 4.5],
    ["code.text", "window.bg", 4.5],
    ["code.key", "window.bg", 4.5],
    ["code.string", "window.bg", 4.5],
    ["code.comment", "window.bg", 4.5],
    ["code.keyword", "window.bg", 4.5],
    ["code.punct", "window.bg", 4.5],
    ["code.note-color", "code.note-bg", 4.5],
    ["outro.link-color", "color.bg", 4.5],
    ["outro.label-color", "color.bg", 4.5],
