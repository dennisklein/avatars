{
  "id": "daylight",
  "title": "Daylight",
  "description": "A light theme: slate page, white cards and nodes, deep teal accent; terminals and code panels stay dark.",
  "fonts": [
    { "family": "Inter", "weight": "400", "file": "inter-400.woff2", "src": "@fontsource/inter/files/inter-latin-400-normal.woff2" },
    { "family": "Inter", "weight": "600", "file": "inter-600.woff2", "src": "@fontsource/inter/files/inter-latin-600-normal.woff2" },
    { "family": "Inter", "weight": "700 800", "file": "inter-800.woff2", "src": "@fontsource/inter/files/inter-latin-800-normal.woff2" },
    { "family": "JetBrains Mono", "weight": "400", "file": "jetbrains-mono-400.woff2", "src": "@fontsource/jetbrains-mono/files/jetbrains-mono-latin-400-normal.woff2" },
    { "family": "JetBrains Mono", "weight": "700", "file": "jetbrains-mono-700.woff2", "src": "@fontsource/jetbrains-mono/files/jetbrains-mono-latin-700-normal.woff2" }
  ],
  "contrast": [
    ["color.text", "color.bg", 4.5],
    ["color.text-strong", "color.bg", 4.5],
    ["color.text-muted", "color.bg", 4.5],
    ["color.accent-soft", "color.bg", 4.5],
    ["color.info-soft", "color.bg", 4.5],
    ["color.text", "color.bg-alt", 4.5],
    ["color.text-muted", "color.bg-alt", 4.5],
    ["color.text", "color.surface", 4.5],
    ["color.text-strong", "color.surface", 4.5],
    ["color.text-muted", "color.surface", 4.5],
    ["color.accent-soft", "color.surface", 4.5],
    ["color.text-strong", "color.surface-raised", 4.5],
    ["color.text-muted", "color.surface-raised", 4.5],
    ["color.on-accent", "color.accent-soft", 4.5],
    ["color.text-dim", "color.surface-sunken", 4.5],
    ["color.code-comment", "color.surface-sunken", 4.5],
    ["color.code-keyword", "color.surface-sunken", 4.5],
    ["headline.color", "color.bg", 3],
    ["slide-title.color", "color.bg", 3],
    ["intro.wordmark-color", "color.bg", 3],
    ["intro.tagline-color", "color.bg", 4.5],
    ["intro.disclosure-color", "color.bg", 4.5],
    ["kicker.color", "color.bg", 4.5],
    ["chapter.color", "color.bg", 4.5],
    ["chapter.accent", "color.bg", 4.5],
    ["caption.text-on", "caption.bg", 4.5],
    ["caption.text", "caption.bg", 4.5],
    ["talk.sub-color", "color.bg", 4.5],
    ["talk.chip-color", "talk.chip-bg", 4.5],
    ["talk.chip-accent-color", "talk.chip-bg", 4.5],
    ["talk.name-color", "talk.tag-bg", 3],
    ["talk.role-color", "talk.tag-bg", 4.5],
    ["slide.bullet-title-color", "slide.bullet-bg", 4.5],
    ["slide.bullet-text-color", "slide.bullet-bg", 4.5],
    ["diagram.title-color", "diagram.node-bg", 4.5],
    ["diagram.text-color", "diagram.node-bg", 4.5],
    ["diagram.title-color", "diagram.node-accent-bg", 4.5],
    ["diagram.text-color", "diagram.node-accent-bg", 4.5],
    ["diagram.text-color", "diagram.ghost-bg", 4.5],
    ["diagram.label-color", "diagram.label-bg", 4.5],
